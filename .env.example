# Локальный шаблон: .env игнорируется Git. Не добавляйте в него реальные данные.
# Для `npm run dev:stack` задавайте переменные окружения процесса; FastAPI не
# читает .env самостоятельно. Значения секретов генерируйте локально, например:
# Python: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Включает только локальные simulated demo-действия; не публикуйте такой режим в LAN/Интернет.
FORPOST_DEMO_MODE=0
FORPOST_DEMO_ACCESS_KEY=GENERATE_LOCALLY_AT_LEAST_32_CHARACTERS
FORPOST_DEMO_ASSERTION_SECRET=GENERATE_LOCALLY_AT_LEAST_32_CHARACTERS

# Необязательное loopback-переопределение. По умолчанию: http://127.0.0.1:8000
FORPOST_BACKEND_URL=http://127.0.0.1:8000

# Генерируется launcher-ом для локального BFF; не задавайте и не сохраняйте секрет вручную.
# FORPOST_API_SERVICE_TOKEN=

# Launcher-ы сами устанавливают признак локального snapshot; не включайте его для внешнего размещения.
# FORPOST_LOCAL_SNAPSHOT=1

# Необязательный путь к Python для `npm run verify:submission`.
# FORPOST_PYTHON=.venv/Scripts/python.exe
